{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "morning-report-trigger",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["5 22 * * *"] },
  "vars": { "ENABLED": "false" },
  "durable_objects": {
    "bindings": [{ "name": "MORNING_TRIGGER", "class_name": "MorningTrigger" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MorningTrigger"] }],
  "observability": { "enabled": true }
}
